# .env.example — template for local development.
# Copy this file to `.env` (which is gitignored) and fill in real values locally.
# NEVER put real secret values in THIS file — it is committed to git.

# Cloudflare API token used by the `wrangler` CLI for deploys.
# Rotate at https://dash.cloudflare.com/profile/api-tokens
# wrangler reads this from the environment automatically.
CLOUDFLARE_API_TOKEN=

# --- Admin login secrets ---
# ADMIN_PASSWORD_HASH, ADMIN_PASSWORD_SALT and ADMIN_PASSWORD_ITERATIONS are
# read by functions/api/_lib/auth.js. In PRODUCTION they live as Cloudflare
# Pages secrets, set via `wrangler pages secret put <NAME>` — NOT committed.
# For LOCAL dev they go in `.dev.vars` (also gitignored), not here.
# Listed here only so developers know these variables exist.
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD_SALT=
# ADMIN_PASSWORD_ITERATIONS=

# SESSION_SECRET signs the admin session cookie (read by the Pages Functions
# auth code). Required in production. Same handling as the admin secrets above:
# a Cloudflare Pages secret in prod, `.dev.vars` for local — never committed.
# SESSION_SECRET=

# --- Personal credentials: DO NOT put these in .env at all ---
# A Gmail account password and GitHub account password / personal access token
# were previously stored in the local .env. These are PERSONAL LOGINS, not
# application secrets, and must NOT live in this repo or any .env file.
# Keep them in a password manager instead, and delete them from your local .env.
# (Keys that were present: GMAIL_USER, GMAIL_PASSWORD, GITHUB_USER,
#  GITHUB_PASSWORD, GITHUB_TOKEN.)
